# ── Site URL (production: your Netlify/Vercel URL) ─────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Netlify sets URL automatically at runtime; optional fallback:
# SHOPIFY_APP_URL=https://pradeepjewellerspj.netlify.app

# ── Shopify store domain (any one name works; aliases are all supported) ───
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_SHOPIFY_STORE=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE=your-store.myshopify.com

# ── Storefront API token (NOT Admin shpat_*) ───────────────────────────────
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
NEXT_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

SHOPIFY_STOREFRONT_API_VERSION=2026-04

# ── Admin API (sync scripts, metafields, draft checkout) ─────────────────
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token

# ── Shopify app OAuth (optional — customer login via Shopify) ────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_customers,read_customers
# SHOPIFY_OAUTH_REDIRECT_URI=  # optional; defaults to {SITE_URL}/api/auth/shopify/callback

# Shopify webhooks (HMAC) — used when deployed
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# Dev-only: serve static product JSON when Shopify has no match (default off in production)
# ALLOW_STATIC_PRODUCT_FALLBACK=true

# ipinfo.io — visitor geo + delivery IP fallback (https://ipinfo.io/json)
# IPINFO_TOKEN=your_ipinfo_token

# Optional: real public IP override during local dev when proxy headers are missing
# VISITOR_GEO_FALLBACK_IP=49.36.123.45

# Supabase (no spaces around =)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_secret_from_dashboard_api
# Store rates table: npm run store-metal-prices:migrate && npm run store-metal-prices:grant
# Vridhhi enquiry form: npm run vridhhi-enquiries:migrate

# Cloudinary (logos + bespoke quote reference uploads)
NEXT_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Signed uploads (recommended) — from Cloudinary dashboard → Settings → API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or unsigned uploads — create an upload preset (folder: bespoke-quotes)
# CLOUDINARY_UPLOAD_PRESET=

# Tawk.to (NEXT_PUBLIC_* required — widget runs in the browser)
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=your_widget_id

# Google OAuth — redirect URI is chosen from the current site URL at login time.
# For local dev, add this exact URI in Google Cloud Console → Authorized redirect URIs:
# http://localhost:3000/api/auth/google/callback
# For Netlify production:
# https://pradeepjewellerspj.netlify.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP
TWOFACTOR_API_KEY=

# Sentry (optional — required on CI/Netlify if source map upload is enabled)
# SENTRY_AUTH_TOKEN=
