# Shopify — use a Storefront API token (NOT Admin shpat_*)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_access_token
SHOPIFY_STOREFRONT_API_VERSION=2026-04
NEXT_SHOPIFY_STORE=your-store.myshopify.com
NEXT_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Public site URL (checkout return link in draft order notes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Gold pricing (dev.metal_prices) — either name works for the URL
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Cloudinary (logos + bespoke quote reference uploads)
NEXT_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Signed uploads (recommended) — from Cloudinary dashboard → Settings → API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or unsigned uploads — create an upload preset (folder: bespoke-quotes)
# CLOUDINARY_UPLOAD_PRESET=

# Tawk.to (NEXT_PUBLIC_* required — widget runs in the browser)
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=your_widget_id

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OTP
TWOFACTOR_API_KEY=
